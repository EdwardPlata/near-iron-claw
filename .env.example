# NEAR AI Cloud — hosted IronClaw connection (OpenAI-compatible gateway)
# Copy this file to .env and fill in a valid key from https://cloud.near.ai
# Endpoint: https://cloud-api.near.ai/v1  (auth: Authorization: Bearer <LLM_API_KEY>)

# IronClaw `openai_compatible` backend vars
LLM_BACKEND=openai_compatible
LLM_BASE_URL=https://cloud-api.near.ai/v1
LLM_API_KEY=sk-agent-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LLM_MODEL=anthropic/claude-sonnet-4-6   # any slug from GET /v1/models

# OpenAI-SDK aliases (so a stock OpenAI client hits the same endpoint)
OPENAI_BASE_URL=https://cloud-api.near.ai/v1
OPENAI_API_KEY=sk-agent-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# NEAR-native alias
NEAR_AI_API_KEY=sk-agent-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
